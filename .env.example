# ==============================================================================
# HAVEN HOUSE - WEB3 CHECKOUT & RESEND NOTIFICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions: Copy this file to .env.local and populate with your live or sandbox keys.

# ⚠️️ CONFIGURE LINE 7: TODO: YOUR_ACTION_HERE (Line 7) - Paste your Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# ⚠️️ CONFIGURE LINE 10: TODO: YOUR_ACTION_HERE (Line 10) - Verified sender email in Resend (e.g., 'orders@havenhouse.com' or 'onboarding@resend.dev' for sandbox)
RESEND_FROM_EMAIL=Haven House <onboarding@resend.dev>

# ⚠️️ CONFIGURE LINE 13: TODO: YOUR_ACTION_HERE (Line 13) - Client crypto wallet address for USDC/USDT settlements (EVM 0x... or Solana pubkey)
NEXT_PUBLIC_CLIENT_WALLET_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e

# ⚠️️ CONFIGURE LINE 16: TODO: YOUR_ACTION_HERE (Line 16) - Secret key shared with the Web3 Payment Gateway (Helio / MoonPay / Custom Webhook) for HMAC-SHA256 signature verification
PAYMENT_GATEWAY_WEBHOOK_SECRET=hh_live_whsec_9876543210abcdef0123456789abcdef

# ⚠️️ CONFIGURE LINE 19: TODO: YOUR_ACTION_HERE (Line 19) - Helio Paylink ID or payment template ID from Helio dashboard (https://app.hel.io)
NEXT_PUBLIC_HELIO_PAYLINK_ID=64fa7980ef550f2694b281f9

# ⚠️️ CONFIGURE LINE 22: TODO: YOUR_ACTION_HERE (Line 22) - MoonPay Publishable API Key (optional if using MoonPay instead of Helio)
NEXT_PUBLIC_MOONPAY_API_KEY=pk_test_1234567890abcdefghijklmnopqrstuv

# ⚠️️ CONFIGURE LINE 25: TODO: YOUR_ACTION_HERE (Line 25) - Canonical URL of your app for webhook callbacks and redirection (default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
